# Порт бэкенда. Фронт слушает 3000, бэкенд — 3001.
API_PORT=3001

# Строка подключения к базе. Локально база живёт в контейнере на порту 5434:
# 5432 занимают штатные установки, 5433 — соседний проект на этой же машине.
# Размер пула сюда НЕ дописывается — он задаётся отдельной переменной ниже,
# иначе число оказывается спрятанным в середине строки и его никто не правит.
DATABASE_URL=postgresql://sporthub:sporthub@127.0.0.1:5434/sporthub?schema=public

# Отдельная база под тесты. Прогон разрушителен — он чистит таблицы между
# кейсами, поэтому смотреть в рабочую базу ему нельзя.
DATABASE_TEST_URL=postgresql://sporthub:sporthub@127.0.0.1:5434/sporthub_test?schema=public

# Размер пула соединений. Пул больше числа ядер не ускоряет, а замедляет:
# соединения начинают конкурировать за те же ядра. На проде — по числу ядер.
#
# ⚠️ Потолок со стороны базы задаётся отдельно — `POSTGRES_MAX_CONNECTIONS`
# в `docker-compose.yml` (30). Расчёт, откуда взялось это число, приведён там же
# в комментарии; при увеличении пула его надо пересчитать по той же формуле.
DATABASE_POOL_SIZE=10

# Яндекс Карты — ключ HTTP-геокодера. Ключ живёт на бэкенде: прокси адресов
# переехало сюда вместе с остальными маршрутами, наружу ключ не уходит.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_key_here

# Яндекс Geosuggest — ключ подсказок адресов, тоже серверный.
YANDEX_SUGGEST_API_KEY=your_key_here

# Адрес площадки, от которого собирается ссылка в письме восстановления пароля.
# Берётся отсюда, а НЕ из заголовков запроса: заголовок `Host` подделывает тот же,
# кто просит письмо, и ссылка ушла бы человеку на чужой сайт вместе с рабочим
# значением. Локально можно не задавать — умолчание `http://localhost:3000`.
# Адрес площадки: ссылка в письме восстановления пароля И список разрешённых
# источников для изменяющих запросов (переопределяется SPORT_HUB_ALLOWED_ORIGINS,
# если адресов несколько).
SPORT_HUB_PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Защита от перебора и от выкачивания платной квоты (шаги 34.51, 34.51a, 34.54)
# ---------------------------------------------------------------------------
#
# Все переменные ниже НЕОБЯЗАТЕЛЬНЫ: без них работают значения по умолчанию,
# указанные в скобках. Мусор и ноль трактуются как «не задано» — опечатка
# в окружении не должна тихо снимать защиту.

# Регистраций с одного адреса за окно (10 штук за час).
# SPORT_HUB_RATE_LIMIT_REGISTER=10
# SPORT_HUB_RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# Обращений к прокси карт с одного адреса за окно (60 штук за минуту).
# Счёт у каждого маршрута свой: перебор координат не гасит подсказки адреса.
# SPORT_HUB_RATE_LIMIT_GEO=60
# SPORT_HUB_RATE_LIMIT_GEO_WINDOW_MS=60000

# Сколько ждать ответа внешней службы карт (5 секунд). Поднимают за медленным
# каналом: без ограничения недоступная служба держит соединение бэкенда.
# SPORT_HUB_GEO_TIMEOUT_MS=5000

# Нарастающая блокировка входа. Неудач на ступень ожидания: по почте (5) и
# по адресу обращения (20). Порог адреса выше намеренно — за общим выходом
# в сеть сидит целый офис, и промахи одного не должны закрывать вход всем.
# SPORT_HUB_LOGIN_LOCKOUT_ATTEMPTS=5
# SPORT_HUB_LOGIN_LOCKOUT_IP_ATTEMPTS=20

# Длина одной ступени (минута), потолок ожидания (30 минут) и срок, после
# которого счёт неудач забывается сам (час).
# SPORT_HUB_LOGIN_LOCKOUT_STEP_MS=60000
# SPORT_HUB_LOGIN_LOCKOUT_MAX_MS=1800000
# SPORT_HUB_LOGIN_LOCKOUT_MEMORY_MS=3600000

# Ключ геокодера — СЕРВЕРНЫЙ и отдельный от того, что вшивается в браузер.
# Одно имя на два ключа означало бы, что серверный уезжает в клиентский бандл.
# Пока не задан, используется прежнее имя NEXT_PUBLIC_YANDEX_MAPS_API_KEY.
# YANDEX_GEOCODER_API_KEY=
