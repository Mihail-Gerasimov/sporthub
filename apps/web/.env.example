# Адрес бэкенда. Фронт проксирует на него все обращения к /api/* и ходит
# по нему же при отрисовке страниц на сервере.
SPORT_HUB_API_ORIGIN=http://localhost:3001

# Яндекс Карты — ключ для карты в браузере (JavaScript API).
# Геокодер и подсказки адресов ключа здесь больше не требуют: их прокси
# переехало на бэкенд, см. apps/api/.env.example.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_key_here
