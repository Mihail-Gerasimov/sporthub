{
  "name": "sporthub-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @sporthub/web",
    "dev:turbo": "npm run dev:turbo -w @sporthub/web",
    "start": "npm run start -w @sporthub/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @sporthub/web",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3.8.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
