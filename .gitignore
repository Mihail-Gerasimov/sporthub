# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# .env версионируется по решению заказчика (17.09.2026): ключи Яндекса бесплатные,
# второй разработчик работает с теми же; остальные .env.* — нет.
.env.*
!.env.example

# vercel
.vercel

# claude code — скилы, конфиг MCP и настройки версионируются: общий контекст для ИИ
# второго разработчика.

# Документы проекта (CLAUDE.md, PHASES_OVERVIEW.md, project-phases/, PROJECT_STATE.md,
# STACK_OVERVIEW.md, README.md) — версионируются с 17.09.2026: второй разработчик и его ИИ
# работают в том же контексте. Черновики — нет.
CODEX.md

# Сгенерированный клиент Prisma — артефакт сборки, а не исходник.
# Генерация встроена в сборку: иначе образ соберётся на клиенте от прошлой схемы.
apps/api/src/storage/prisma-client/

# typescript
*.tsbuildinfo

# Сборка внутренних пакетов монорепо (packages/*) — артефакт, не исходник
packages/*/dist/
apps/*/dist/
next-env.d.ts

# E2E: прогонщики (tests/*.mjs), чек-листы, отчёты и конфиг Playwright MCP версионируются —
# без них отчёты не воспроизвести. Скриншоты падений остаются локальными: двоичный шум,
# воспроизводимый прогоном.
tests/screenshots/

# Личные заметки и документы (черновики, не коммитим)
ЗАМЕТКИ.md
*.docx

# Артефакты Claude Design (handoff-bundle, ~3.4MB, локальный референс для редизайна)
claude-design/

# Документы для регистрации ПО (интеллектуальная собственность, до подачи заявки — локально)
patent/

# Экспорт нового дизайна из Figma Make — локальный референс, в git не идёт (решение 17.09).
проспорт/
prosport/
prosportmake.make
# Снимки базы (`npm run db:dump`) не коммитим — кроме одного общего снимка стенда
# `backups/sporthub-dev.sql` (демо-данные сида, пароль у всех sporthub123), чтобы второй
# разработчик поднял ту же базу.
backups/*
!backups/sporthub-dev.sql
