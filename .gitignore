# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code
/.claude/

# project docs (internal, not for production)
CLAUDE.md
CODEX.md
PHASES_OVERVIEW.md
project-phases/
feature-docs/
PROJECT_STATE.md
STACK_OVERVIEW.md
README.md

# Сгенерированный клиент Prisma — артефакт сборки, а не исходник.
# Генерация встроена в сборку: иначе образ соберётся на клиенте от прошлой схемы.
apps/api/src/storage/prisma-client/

# typescript
*.tsbuildinfo

# Сборка внутренних пакетов монорепо (packages/*) — артефакт, не исходник
packages/*/dist/
apps/*/dist/
next-env.d.ts

# E2E tests (локальная работа, не коммитим)
.mcp.json
# Игнорируем содержимое, а не сам каталог: иначе git внутрь не заглянет и исключения ниже
# не сработают.
tests/*
# Исключение: чек-листы и отчёты прогонов — артефакты приёмки фаз, они версионируются.
# Скриншоты падений остаются локальными: это двоичный шум, воспроизводимый прогоном.
!tests/checklists/
!tests/reports/

# Личные заметки (черновик, не коммитим)
ЗАМЕТКИ.md

# Артефакты Claude Design (handoff-bundle, ~3.4MB, локальный референс для редизайна)
claude-design/

# Документы для регистрации ПО (интеллектуальная собственность, до подачи заявки — локально)
patent/

# Экспорт нового дизайна из Figma Make (8.7 МБ исходников, локальный референс — как claude-design/)
# ⚠️ Каталог пересоздаётся выгрузкой и меняет имя: был «проспорт», стал «prosport».
# Держим оба, иначе свежая выгрузка молча попадёт в индекс.
проспорт/
prosport/
prosportmake.make
# Снимки базы (`npm run db:dump`). Не коммитим: внутри хеши паролей, почты и телефоны
# живых людей, и восстанавливаются они из своего места, а не из истории репозитория.
backups/
