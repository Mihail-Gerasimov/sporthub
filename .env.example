# Переменные окружения для docker compose.
#
# Файл читается САМИМ compose (не приложением) и подставляется в docker-compose.yml.
# Переменные приложения — отдельно, в `apps/api/.env` (образец: `apps/api/.env.example`).
#
# Локально можно ничего не заводить: у всех значений есть умолчания, они прописаны
# в самом compose. На сервере обязателен только пароль — умолчание туда не годится.
#
# Значения ниже совпадают с умолчаниями compose: файл показывает ПОЛНЫЙ набор ручек,
# а не только те, что кто-то однажды понадобился менять. Раньше здесь была одна
# строка из девяти, и остальные восемь можно было найти только чтением compose.

# --- База ---------------------------------------------------------------------

# Пароль учётной записи базы.
# ⚠️ Применяется ОДИН РАЗ, при создании тома. Смена пароля позже требует
# либо `ALTER USER` в самой базе, либо пересоздания тома.
POSTGRES_PASSWORD=sporthub

# Память базы. Числа подобраны под маленький сервер, где рядом живут ещё два
# процесса приложения: умолчания PostgreSQL рассчитаны на машину, где база одна.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB

# Потолок клиентских соединений. Расчёт — в комментарии docker-compose.yml
# рядом с этой переменной; коротко: пул бэкенда × 2 + миграции + ручные + резерв.
# ⚠️ Растёт DATABASE_POOL_SIZE — по той же формуле пересчитывается и это число.
POSTGRES_MAX_CONNECTIONS=30

# --- Приложение ---------------------------------------------------------------

# Размер пула соединений бэкенда. Каждое соединение — свой набор буферов,
# и при двух ядрах большой пул не ускоряет, а отнимает память.
DATABASE_POOL_SIZE=10

# --- Ключи карт ---------------------------------------------------------------

# Ключ Яндекс.Карт для фронта.
# ⚠️ Вшивается в бандл НА СБОРКЕ (ARG в web.Dockerfile) — рантайм-переменной
# его не подменить. Меняется вместе с пересборкой образа.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Ключ подсказок адресов. Читается бэкендом в рантайме: запросы к Яндексу
# идут через него, наружу ключ не уходит.
YANDEX_SUGGEST_API_KEY=

# --- Восстановление пароля ------------------------------------------------------

# Адрес площадки, от которого собирается ссылка в письме (шаг 34.71). На сервере
# обязателен: без него письма уводили бы человека на localhost.
SPORT_HUB_PUBLIC_ORIGIN=http://localhost:3000

# Серверный ключ геокодера (см. apps/api/.env.example).
# YANDEX_GEOCODER_API_KEY=
