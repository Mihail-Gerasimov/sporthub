# Переменные окружения для docker compose.
#
# Файл читается самим compose (не приложением) и подставляется в docker-compose.yml.
# Локально можно ничего не заводить: у всех значений есть значения по умолчанию.
# На сервере пароль обязателен — значение по умолчанию туда не годится.

# Пароль учётной записи базы.
POSTGRES_PASSWORD=sporthub
